{
  "layer": "top",
  "position": "top",
  "height": 34,
  "margin-top": 6,
  "margin-left": 8,
  "margin-right": 8,
  "spacing": 8,
  "modules-left": ["custom/launcher", "river/tags"],
  "modules-center": ["river/window"],
  "modules-right": ["cpu", "memory", "clock"],
  "custom/launcher": {
    "format": "Apps",
    "on-click": "fuzzel --config /root/.config/river/fuzzel/fuzzel.ini",
    "tooltip": false
  },
  "river/tags": {
    "num-tags": 5
  },
  "river/window": {
    "max-length": 44,
    "tooltip": false
  },
  "cpu": {
    "interval": 2,
    "format": "CPU {usage}%"
  },
  "memory": {
    "interval": 5,
    "format": "RAM {used:0.1f}G"
  },
  "clock": {
    "format": "{:%a %d %b  %H:%M}"
  }
}
