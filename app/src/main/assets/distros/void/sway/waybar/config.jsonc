{
  "layer": "top",
  "position": "top",
  "height": 34,
  "margin-top": 6,
  "margin-left": 8,
  "margin-right": 8,
  "spacing": 8,
  "modules-left": ["custom/launcher", "sway/workspaces", "sway/mode"],
  "modules-center": ["sway/window"],
  "modules-right": ["cpu", "memory", "clock"],
  "custom/launcher": {
    "format": "Apps",
    "on-click": "fuzzel --config /root/.config/sway/fuzzel/fuzzel.ini",
    "tooltip": false
  },
  "sway/workspaces": {
    "disable-scroll": false,
    "all-outputs": true,
    "format": "{name}"
  },
  "sway/mode": {
    "format": "RESIZE"
  },
  "sway/window": {
    "max-length": 44,
    "tooltip": false
  },
  "cpu": {
    "interval": 2,
    "format": "CPU {usage}%"
  },
  "memory": {
    "interval": 5,
    "format": "RAM {used:0.1f}G"
  },
  "clock": {
    "format": "{:%a %d %b  %H:%M}"
  }
}
