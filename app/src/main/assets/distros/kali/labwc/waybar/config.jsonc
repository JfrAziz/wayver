{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 4,
  "modules-left": ["custom/term", "custom/files"],
  "modules-center": ["wlr/taskbar"],
  "modules-right": ["cpu", "memory", "clock"],
  "custom/term": {
    "format": ">_ Term",
    "on-click": "foot -c /root/.config/labwc/foot/foot.ini",
    "tooltip": false
  },
  "custom/files": {
    "format": "Files",
    "on-click": "pcmanfm",
    "tooltip": false
  },
  "wlr/taskbar": {
    "format": "{icon} {title:.18}",
    "icon-size": 16,
    "on-click": "activate",
    "on-click-middle": "close"
  },
  "cpu": {
    "interval": 2,
    "format": "CPU {usage}%"
  },
  "memory": {
    "interval": 5,
    "format": "RAM {used:0.1f}G"
  },
  "clock": {
    "format": "{:%a %d %b  %H:%M}"
  }
}
